#!/usr/bin/env bash
# Stands in for the two brew commands verify-published-bottles.sh runs, so the
# tests need no Homebrew install, real tap or network:
# - `brew info --json=v2 <tap>/<name>` reports the `all:` sha256 from the
#   bottle block of Formula/<name>.rb in the current directory, if any.
# - `brew fetch ... <tap>/<name>` succeeds only when published/<name> exists
#   and holds that same sha256, standing in for the file at root_url.
set -euo pipefail

command="$1"
name="${!#}"
name="${name##*/}"
file="Formula/${name}.rb"
sha="$(sed -n 's|.* all: "\([0-9a-f]*\)".*|\1|p' "$file" | head -1)"

case "$command" in
  info)
    if [ -n "$sha" ]; then
      printf '{"formulae":[{"bottle":{"stable":{"files":{"all":{"sha256":"%s"}}}}}]}\n' "$sha"
    else
      printf '{"formulae":[{"bottle":{}}]}\n'
    fi
    ;;
  fetch)
    [ -f "published/${name}" ] && [ "$(cat "published/${name}")" = "$sha" ]
    ;;
  *)
    echo "fake-brew: unexpected command $command" >&2
    exit 2
    ;;
esac
